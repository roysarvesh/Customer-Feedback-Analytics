# ─────────────────────────────────────────────
# .gitignore for Customer Feedback Analytics Platform
# ─────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data files — raw and processed (large, not committed)
data/raw/*.csv
data/raw/*.json
data/raw/*.parquet
data/processed/*.csv
data/database/*.db

# But commit the schema and gitkeep files
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/database/.gitkeep

# Logs
*.log
logs/

# Streamlit secrets
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
.coverage
htmlcov/
.pytest_cache/
